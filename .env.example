# Copy to .env and fill in. Placeholders only; never commit real keys.
# In the Tenki sandbox these are sourced from the shared volume .env
# ($HERMES_HOME/.env) by start-starter.sh, so you do not set them there by hand.

# Nebius Token Factory (inference). OpenAI-compatible.
NEBIUS_API_KEY=your-nebius-token-factory-key
# Optional overrides (defaults shown):
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily (web search).
TAVILY_API_KEY=your-tavily-key

# Server port (the starter serves the SPA + API here).
# PORT=3000
